.env
# AI模型缓存
model_cache/

# Python虚拟环境和缓存
venv/
__pycache__/
*.pyc
*.pyo
*.pyd
*.so
.Python
*.egg-info/
dist/
build/

# 报告目录（自动生成，默认忽略）
reports/*

# 分析报告目录（完全忽略，不提交到远端）
reports/analysis/

# IDE和编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# Pytest 缓存目录（放在 tests 下）
tests/.pytest_cache/
.pytest_cache/

# 测试脚手架临时目录：pytest 在本环境需要把 TEMP/TMP 指向工作区内的可写路径
# （沙箱/权限限制下无法使用系统临时目录），内含 pytest basetemp 与 tmp* 空目录
.tmp_test/

# 测试结果和待办文件（本地调试用）
tests/testResult.txt
tests/testResult2.txt
tests/testResult3.txt
tests/todoList.txt
tests/language_support_test_report.json
tests/testResult/*

# BigVul测试数据集（大型文件，不提交到远端）
tests/BigVul/

# SQLite 运行时数据库文件
infrastructure/database/*.db
infrastructure/database/*.sqlite
infrastructure/database/*.sqlite3
infrastructure/database/*.db-*
infrastructure/database/*.db-journal
infrastructure/database/*.db-wal

# 专利资料目录
专利/

# ------------------------------------------------------------------ #
# 以下为「不要提交」的目录 / 文件（**明确排除**，避免误提交）
# ------------------------------------------------------------------ #

# 论文、软著资料目录（与专利同类：属于成果材料，不进代码仓库）
论文/
软著/
# 论文草稿、参考文献、演示材料（同样是成果材料）
docs/
refers/
demo/

# 大数据包 / 安装包（上百 MB，且可从官方渠道重新获取）
BigVul.tar.gz
*.tar.gz
*.zip
*.msi

# 第三方库的本地副本 / 备份目录
local_libs/
reports_backup_westb/
_pre_sync_backup_*/

# 知识库构建的中间产物（可由 utils/bigvul_ingest/ 重新生成）
utils/bigvul_ingest/output/

# 一次性诊断脚本：按约定以 `_` 开头，属于"用完即弃"，不入库
# （可复用的实验工具请用不带下划线的名字）
utils/experiments/_*

# 本地环境备忘 / 临时清单
AutoDL环境安装备忘.md
struct.txt
seq_status.sh
run_login_seq.sh
check_run.sh
check_missing.sh

# 专利检索报告 / 现有技术调研报告（成果材料，不进代码仓库）
专利检索报告*.md
prior_art_report_*.md

# 会 rm -rf 数据目录的脚本：故意**不入库**，避免被误执行（详见《03》坑 8）
utils/experiments/start_weaviate.sh

# 生成物（向量库导出的 jsonl 等）
utils/experiments/*.jsonl
